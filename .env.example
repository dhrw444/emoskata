# emoskata 系统配置模板。复制为 .env，填好后与程序一起上传。
# 程序不会创建或自动改写 .env；只有管理员网页保存时才写回文件。
# 文件权限应为 0600。标“重启生效”的项修改后要重启核心。

# 管理员密码：至少 8 字符；空白保存保留现值。
PANEL_PASSWORD=""

# 网页监听端口（重启生效）：容器内端口；宿主端口映射需在容器配置中对应修改。
PORT="8080"

# 监听地址（重启生效）：0.0.0.0 监听所有网卡；容器 IP 自动识别仅用于显示。
HTTP_HOST="0.0.0.0"

# 启用网页（重启生效）：关闭后网页无法操作，只保留 Bot 和调度。
HTTP_ENABLED="1"

# 数据目录（重启生效）：相对路径以入口文件目录为基准；内含账号密钥，需持久化。
DATA_DIR="./data"

# Telegram Bot Token：BotFather 签发；空白保存保留，勾选清除才删除。
TG_BOT_TOKEN=""

# Telegram API 地址（重启生效）：官方地址或可信 Bot API 服务，不包含 /bot 或 Token。
TG_API_BASE_URL="https://api.telegram.org"

# emos API 地址：官方主站与 api.emos.best 互为备用；自定义站不向公共站发送密钥。
EMOS_BASE_URL="https://emos.best"

# 个人网页公开地址：公网必须 HTTPS，仅填写域名与可选端口，不含路径。
WEB_BASE_URL=""

# 管理员网页公开地址：可选；反向代理时填写可信 HTTPS 地址供同源与 Cookie 判断。
PUBLIC_BASE=""

# 默认签到时间：格式 HH:MM；官方禁止 0 点，范围 01:00–23:59。
SIGN_TIME="08:00"

# 签到时区：IANA 时区；系统需安装 tzdata，固定偏移常用区支持兜底。
SIGN_TIMEZONE="Asia/Shanghai"

# 账号间隔（秒）：避免账号请求集中；范围 2–300 秒。
GAP_SECONDS="8"

# emos 请求超时（秒）：单次网络请求上限。
EMOS_TIMEOUT="20"

# 失败退避（秒）：1–5 档递增，每档至少 300 秒；当天耗尽后停止。
RETRY_DELAYS="300,900,2700"

# Bot 操作线程数（重启生效）：默认 2；1 更省内存，最多 8。
BOT_WORKERS="2"

# Bot 待办上限（重启生效）：包含正在运行任务；达到上限后明确拒绝新操作。
BOT_MAX_JOBS="16"

# 唯一 TG 用户 ID：只填一个正整数 ID；同时作为通知接收人。留空关闭 Bot 和个人网页入口。
TG_ALLOWED_USER_IDS=""

# emos 用户 ID：emos 官网账号卡片上的用户 ID；填写后 /login 直接跳转官方 Bot，不再要求输入。
EMOS_USER_ID=""

# emos 官方授权 Bot：官方授权入口的 Bot 用户名，不含 @；官方变更时只改这里。
EMOS_AUTH_BOT="emospg_bot"

# TG 长轮询等待（秒）（重启生效）：延长空闲等待减少连接与 CPU；范围 10–50。
TG_POLL_TIMEOUT="45"

# 本地调度检查（秒）：只检查本地数据库，不轮询官方接口。
SCHEDULER_INTERVAL="60"

# 网页请求超时（秒）（重启生效）：防止空连接永久占用线程。
HTTP_REQUEST_TIMEOUT="15"

# 网页并发连接上限（重启生效）：超出立即返回忙碌；减少线程和内存峰值。
HTTP_MAX_CONNECTIONS="8"

# 管理员会话（小时）：管理员 Cookie 有效期；改密码会清除管理员会话。
ADMIN_SESSION_HOURS="24"

# 个人网页会话（小时）：只代表当前 TG 用户，不获得其他账号登录权限。
WEB_SESSION_HOURS="168"

# 软重启收尾上限（秒）：停止接新任务并等待网络任务结束；未收尾不会强行 exec。
SHUTDOWN_TIMEOUT="90"
